# NBA Player Stats Predictor — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── The Odds API (live sportsbook odds) ────────────────────────────────────
# Sign up at https://the-odds-api.com — free tier gives 500 requests/month.
# Free tier is enough for development (NBA player props refresh every 30 min).
THE_ODDS_API_KEY=your_key_here
# ── Kaggle (for training data downloads) ───────────────────────────────────
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# ── Bulk data cache location ───────────────────────────────────────────────
# Large Kaggle downloads are kept off the internal SSD. Honored by
# utils/kaggle_loader.py; kagglehub defaults to ~/.cache/kagglehub when unset.
#
# On this machine it is exported from the shell profile, already pointing at
# the external drive (~47 GB of datasets live there). Note that load_dotenv()
# does NOT override an existing shell variable, so setting this key here has
# no effect when the profile already exports it — change it in the profile.
#
#   export KAGGLEHUB_CACHE=/Volumes/T7/kagglehub
#
# Requires the drive to be mounted; the loader raises a clear error if not.
